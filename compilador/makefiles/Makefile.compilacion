# Makefile especializado para las pruebas del generador de código de máquina (ROM)
CC = gcc
CFLAGS = -Wall -Wextra -g

SRC_DIR = .
SRC_CORE = $(SRC_DIR)/lexer/lexer.c \
           $(SRC_DIR)/parser/parser.c \
           $(SRC_DIR)/encoder/encoder.c \
           $(SRC_DIR)/helpers/escritor_rom.c \
           $(SRC_DIR)/helpers/compilador_helper.c

GPU_HELPERS = $(SRC_DIR)/helpers/compile_text.c

all: test_movi test_movimiento_general test_alu test_flags test_pc test_gpu test_inputs

test_movi: $(SRC_DIR)/tests/tests_compilacion/test_movi.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_movi_exec

test_movimiento_general: $(SRC_DIR)/tests/tests_compilacion/test_movimiento_general.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_movimiento_general_exec

test_alu: $(SRC_DIR)/tests/tests_compilacion/test_alu.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_alu_exec

test_flags: $(SRC_DIR)/tests/tests_compilacion/test_flags.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_flags_exec

test_pc: $(SRC_DIR)/tests/tests_compilacion/test_pc.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_pc_exec

test_gpu_hello_world: $(SRC_DIR)/tests/tests_compilacion/tests_gpu/test_hello_world.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_gpu_hello_world_exec

test_gpu_lorem_ipsum: $(SRC_DIR)/tests/tests_compilacion/tests_gpu/test_lorem_ipsum.c $(SRC_CORE)  $(GPU_HELPERS)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_gpu_lorem_ipsum_exec

test_gpu_scroll: $(SRC_DIR)/tests/tests_compilacion/tests_gpu/test_scroll.c $(SRC_CORE)  $(GPU_HELPERS)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_gpu_scroll_exec

test_inputs: $(SRC_DIR)/tests/tests_compilacion/test_inputs.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_inputs_exec

test_etiquetas: $(SRC_DIR)/tests/tests_compilacion/test_etiquetas.c $(SRC_CORE)
	$(CC) $(CFLAGS) $^ -o $(SRC_DIR)/test_etiquetas_exec

clean:
	rm -f $(SRC_DIR)/test_movi_exec $(SRC_DIR)/test_movimiento_general_exec $(SRC_DIR)/test_alu_exec $(SRC_DIR)/test_flags_exec $(SRC_DIR)/test_pc_exec $(SRC_DIR)/test_gpu_exec $(SRC_DIR)/test_inputs_exec